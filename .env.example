# @raviraj87/dynatrace-mcp · .env.example
# Environment variable template for Dynatrace MCP configuration.
# Copyright (c) 2026 Ravi Raj · MIT License · see LICENSE

DYNATRACE_URL=https://abc12345.apps.dynatrace.com
DYNATRACE_API_TOKEN=dt0s16.your-platform-token
# DT_ENVIRONMENT=https://abc12345.apps.dynatrace.com
# DT_PLATFORM_TOKEN=dt0s16.your-platform-token

# Named connections (optional)
# DYNATRACE_DEFAULT_CONNECTION=default
# DYNATRACE_STAGE_URL=https://stage.apps.dynatrace.com
# DYNATRACE_STAGE_TOKEN=dt0s16.stage-token
# DYNATRACE_PROD_URL=https://prod.apps.dynatrace.com
# DYNATRACE_PROD_TOKEN=dt0s16.prod-token
# DYNATRACE_CONNECTIONS={"qa":{"url":"https://qa.apps.dynatrace.com","token":"dt0s16.qa-token"}}

# Grail scan budget per MCP session (default 1000 GB)
# DYNATRACE_GRAIL_QUERY_BUDGET_GB=1000

# TLS
# NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem
# DYNATRACE_NO_SSL_VERIFY=true
